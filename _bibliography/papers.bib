@misc{suri2026frames2lora,
  preview = {suri2026frames2lora.png},
  title = {Frames2LoRA: Parametric Video Internalization for Vision-Language Models},
  author = {Suri*, Manan and Baskar*, Sarvesh and Manocha, Dinesh},
  year = {2026},
  month = jun,
  eprint = {2606.04351},
  archivePrefix = {arXiv},
  primaryClass = {cs.CV},
  url = {https://arxiv.org/abs/2606.04351},
  note = {* equal contribution. Formerly titled Video2LoRA (arXiv v1).},
  abstract = {Video is expensive for vision-language models: every frame costs hundreds of tokens, and every repeated query pays that cost again. Frames2LoRA internalizes a video parametrically. A perceiver hypernetwork reads the frozen VLM's layer-wise states as it encodes a video and generates a LoRA adapter in a single forward pass, with no gradient updates. The adapter-augmented model then answers arbitrary queries with zero visual tokens in context: up to 1,500x lower visual-token load and 6-80x faster time-to-first-token, with outputs statistically non-inferior to full video-in-context inference.},
  abbr = {arXiv},
  bibtex_show = {true},
  html = {https://arxiv.org/abs/2606.04351},
  pdf = {https://arxiv.org/pdf/2606.04351},
  press = {https://www.cs.umd.edu/article/2026/07/teaching-ai-see-faster},
  website = {https://frames2lora.github.io/},
  code = {https://github.com/frames2lora/Frames2LoRA},
  checkpoints = {https://huggingface.co/MananSuri27/Frames2LoRA-SmolVLM-ckpts/tree/main},
  selected = {true}
}

